PROJECT_NAME="SmartMart Supermarket API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Secret Key for JWT Tokens (change in production)
SECRET_KEY="smartmart_supermarket_jwt_secret_key_prod_2026_x9f7a8"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Connection
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/smartmart"

# Set to True to allow automatic local SQLite fallback if PostgreSQL is not running
USE_SQLITE_FALLBACK_IF_PG_UNAVAILABLE=True
SQLITE_DATABASE_URL="sqlite:///./smartmart.db"

# Admin Initial Seed
FIRST_SUPERUSER_EMAIL="admin@smartmart.com"
FIRST_SUPERUSER_PASSWORD="admin123"
